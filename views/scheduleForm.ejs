<!DOCTYPE html>
<html>
<%- include('./partials/head.ejs') %>
<body>
<%- include('./partials/nav.ejs') %>

<div class="container">
    <h4>
        <%= title %>
    </h4>
    <p>
        Schedule selected activity:
    </p>
    <p>
    <form action="/activity">

        <input type="hidden" name="name" value="<%= activity.name %>">
        <input type="hidden" name="action" value="schedule">

        <!-- the mode selection -->
        <p>
            <label>
                <input name="mode" type="radio" value="ASAP" checked/>
                <span>ASAP</span>
            </label>
        </p>
        <p>
            <label>
                <input name="mode" type="radio" value="JIT"/>
                <span>JIT</span>
            </label>
        </p>

        <!-- the date selection -->
        <p>
            <input id="date" name="date" type="text" value="2026-12-01"/>
            <label for="date">Date</label>
        </p>
        <p>
            <input id="time" name="time" type="text" value="18:00:00"/>
            <label for="time">Time</label>
        </p>

        <input class="waves-effect waves-light btn" type="submit" value="Submit">

    </form>
    <p></p>
</div>
</body>

<!--JavaScript at end of body for optimized loading-->
<script type="text/javascript" src="javascripts/materialize.min.js"></script>
</html>
