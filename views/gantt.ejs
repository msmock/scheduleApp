<!DOCTYPE html>
<html>
<%- include('./partials/head.ejs') %>
<body>
<%- include('./partials/nav.ejs') %>

<div class="row">
    <svg class="row col s12" id="gantt"/>
</div>

</body>

<script src="../javascripts/snap.svg-min.js"></script>
<script src="../javascripts/date.js"></script>

<script>

    window.onload = function () {

        // ----- style options -----
        const cellOptEven = {fill: "#FFFFFF", stroke: "#A0A0A0", strokeWidth: 0.5, "fill-opacity": 0.5};
        const cellOptOdd = {fill: "#F0F0F0", stroke: "#A0A0A0", strokeWidth: 0.5, "fill-opacity": 0.5};
        const tickOpt = {fill: "#F0F0F0", stroke: "#A0A0A0", strokeWidth: 1, "fill-opacity": 0.5};
        const actionSymbolOpt = {fill: "#00695c", stroke: "#00695c", strokeWidth: 0.5, "fill-opacity": 0.5};
        const txtOpt = {'font-size': 9, 'font-family': '"Helvetica", Helvetica, Sans-serif', fill: "#404040"};

        // ----- layout constants -----
        const headerHeight = 40;
        const rowHeight = 25;
        const labelWidth = 100;
        const textX = 10;
        const textY = rowHeight / 2 + 5;
        const totalWidth = 800; //800;

        // ----- time constants (ms) -----
        const MINUTE = 60 * 1000;
        const HOUR = 60 * MINUTE;
        const DAY = 24 * HOUR;
        const WEEK = 7 * DAY;
        const MONTH = 30 * DAY;
        const YEAR = 365 * DAY;

        // ordered largest-to-smallest so we can find the first unit the span exceeds
        const RESOLUTIONS = [
            {unit: 'years', ms: YEAR},
            {unit: 'months', ms: MONTH},
            {unit: 'weeks', ms: WEEK},
            {unit: 'days', ms: DAY},
            {unit: 'hours', ms: HOUR},
            {unit: 'minutes', ms: MINUTE},
        ];

        // how to round the start date and step forward, per unit
        const TICK_CONFIG = {
            years: {
                round: d => d.at({month: 0, day: 1, hour: 0, minute: 0, second: 0}),
                step: d => d.add(1).year(),
                format: 'yyyy',
                duration: 365*24*60*60*1000
            },
            months: {
                round: d => d.at({day: 1, hour: 0, minute: 0}),
                step: d => d.add(1).month(),
                format: 'MM.yyyy',
                duration: 30*24*60*60*1000
            },
            weeks: {
                round: d => d.at({day: 1, hour: 0, minute: 0}),
                step: d => d.add(1).week(),
                format: 'dd.MM',
                duration: 7*24*60*60*1000
            },
            days: {
                round: d => d.at({hour: 0, minute: 0, second: 0}),
                step: d => d.add(1).day(),
                format: 'dd.MM',
                duration: 24*60*60*1000
            },
            hours: {
                round: d => d.at({minute: 0, second: 0}),
                step: d => d.add(1).hour(),
                format: 'HH:mm',
                duration: 60*60*1000
            },
            minutes: {
                round: d => d.at({second: 0}),
                step: d => d.add(1).minute(),
                format: 'mm',
                duration: 60*1000
            },
        };

        let timeRange;

        refresh();

        /**
         * get fresh data from the server
         */
        function refresh() {
            const xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (this.readyState === 4 && this.status === 200) {
                    render(JSON.parse(this.responseText));
                }
            };
            xhttp.open("GET", "/api/actions", true);
            xhttp.setRequestHeader("Content-type", "application/json");
            xhttp.send();
        }

        /**
         * find the time unit to use for labeling the Gantt chart's axis —
         * largest unit that gives at least 1 whole tick over the given time span.
         **/
        function getResolution(span) {
            for (const {unit, ms} of RESOLUTIONS) {
                if (span >= ms) return {unit};
            }
            return {unit: 'seconds', count: Math.floor(span / 1000)};
        }

        /**
         * get the earliest and latest time to be shown in the gantt
         * from the earliest and latest times of the values.
         *
         * @returns {{earliest: number, latest: number, span: number, duration: number}}
         */
        function getTimeRange(actions) {

            // first set the range to the start and end of the activities
            const earliest = Math.min(...actions.map(a => a.start));
            const latest = Math.max(...actions.map(a => a.end));
            const span = latest - earliest;

            // calculate the resolution from the data above
            const resolution = getResolution(span);
            const config = TICK_CONFIG[resolution.unit];

            // return a range with a little more space at the edge
            return {
                earliest: earliest - config.duration,
                latest: latest + config.duration,
                span: span + 2*config.duration, // padded on both sides, so span grows by 2 × 5%
            };
        }

        /**
         * Convert the time (ms) in the x-Position in the tickDrawArea.
         */
        function timeToX(time, earliest, scale) {
            return (time - earliest) * scale;
        }

        /**
         * Convert the x-Position in the tickDrawArea to the time.
         */
        function xToTime(x, earliest, scale) {
            return x / scale + earliest;
        }

        /**
         * draw the tick lines and labels
         */
        function drawTicks(paper, tickDrawArea, resolution, timeRange, scale, dateY, innerHeight) {

            const config = TICK_CONFIG[resolution.unit];
            if (!config) return; // 'seconds' spans too short to tick

            const drawTick = date => {

                const x = timeToX(date.getTime(), timeRange.earliest, scale);

                const line = paper.line(x, headerHeight, x, innerHeight + headerHeight).attr(tickOpt);
                tickDrawArea.append(line);

                const label = paper.text(x - 10, dateY, date.toString(config.format)).attr(txtOpt);
                const title = Snap.parse(`<title>${date.toString('dddd, d.M.yyyy HH:mm')}</title>`);
                label.append(title);
                tickDrawArea.append(label);
            };

            let date = config.round(new Date(timeRange.earliest));

            for (; date.getTime() <= timeRange.latest; config.step(date)) {
                if (date.getTime() >= timeRange.earliest) drawTick(date);
            }
        }

        /**
         * render the resource gantt
         */
        function render(actions) {

            // keep a reference to the full list before it gets shadowed below
            const allActions = actions;

            // clear any previous drawing before redrawing
            const paper = Snap("#gantt");
            paper.clear();

            // unique actors, and a map of actor -> their actions
            const actors = [...new Set(allActions.map(action => action.actorChosen))];

            const actionsOnActor = new Map();
            for (const action of allActions) {
                const actor = action.actorChosen;
                if (!actionsOnActor.has(actor)) actionsOnActor.set(actor, []);
                actionsOnActor.get(actor).push(action);
            }

            const innerHeight = actors.length * rowHeight;
            const totalHeight = Math.max(innerHeight + headerHeight, 800);
            paper.attr({viewBox: [0, 0, totalWidth, totalHeight]});

            // get the time range to display
            if (!timeRange) {
                timeRange = getTimeRange(actions);
            }

            const resolution = getResolution(timeRange.span);
            const range = totalWidth - labelWidth;
            const scale = range / timeRange.span;

            // header background
            const headerCell = paper.g();
            headerCell.append(paper.rect(0, 0, range, headerHeight, 2, 2).attr(cellOptEven));
            headerCell.transform(`translate(${labelWidth} 0)`);

            // area to draw tick lines to
            const tickDrawArea = paper.g();
            headerCell.append(tickDrawArea);

            const dateY = headerHeight - 4;
            drawTicks(paper, tickDrawArea, resolution, timeRange, scale, dateY, innerHeight);

            // rows: one per actor
            let vShift = headerHeight;
            actors.forEach((actor, rowIndex) => {

                const cellOption = rowIndex % 2 ? cellOptEven : cellOptOdd;
                const actions = actionsOnActor.get(actor);

                const row = paper.g();
                row.transform(`translate(0 ${vShift})`);

                const labelCell = paper.g();
                labelCell.append(paper.rect(0, 0, labelWidth, rowHeight, 2, 2).attr(cellOption));
                labelCell.append(paper.text(textX, textY, actor).attr(txtOpt));
                row.append(labelCell);

                const actionCell = paper.g();
                actionCell.append(paper.rect(0, 0, range, rowHeight, 2, 2).attr(cellOption));
                actionCell.transform(`translate(${labelWidth} 0)`);

                // click listener with time projection
                actionCell.node.addEventListener('click', function (evt) {

                    // Get SVG element position
                    const rect = actionCell.node.getBoundingClientRect();

                    // position relative to cell
                    const svgX = evt.clientX - rect.left;
                    const svgY = evt.clientY - rect.top;
                    console.log(`Click position relative to cell: x=${svgX}, y=${svgY}`);

                    // scale click position
                    const svgWidth = totalWidth - labelWidth;
                    const svgScale = svgWidth / rect.width;

                    // convert to time
                    const time = xToTime(svgX * svgScale, timeRange.earliest, scale);
                    console.log('clicked at x=%s, time=%s', svgX, new Date(time));
                });

                // add double click listener
                actionCell.node.addEventListener("dblclick", function (evt) {
                    console.log('double clicked at x=%s y=%s', evt.clientX, evt.clientY);
                    timeRange = {
                        earliest: timeRange.earliest - 1000 * 60 * 60,
                        latest: timeRange.latest + 1000 * 60 * 60,
                        span: timeRange.span * 1.1, // padded on both sides, so span grows by 2 × 5%
                    };
                    render(allActions);
                });

                row.append(actionCell);

                const drawArea = paper.g();
                actionCell.append(drawArea);

                for (const action of actions) {

                    const x = timeToX(action.start, timeRange.earliest, scale);
                    const width = Math.max((action.end - action.start) * scale, 2);

                    const actionSymbol = paper.rect(x, 8, width, 9, 2, 2).attr(actionSymbolOpt);
                    actionSymbol.node.source = action;

                    const startDate = new Date(action.start).toString('d.M.yyyy HH:mm');
                    const endDate = new Date(action.end).toString('d.M.yyyy HH:mm');
                    const title = Snap.parse(
                        `<title>Action: \nName: ${action.name}\nStart: ${startDate}\nEnd: ${endDate}\nPath: ${action.locator}</title>`
                    );
                    actionSymbol.append(title);
                    drawArea.append(actionSymbol);
                }

                vShift += rowHeight;
            });
        }
    };
</script>

<!--JavaScript at end of body for optimized loading-->
<script type="text/javascript" src="javascripts/materialize.min.js"></script>
</html>