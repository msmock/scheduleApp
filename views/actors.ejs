<!DOCTYPE html>
<html>
  <% include partials/head %>

  <body>
    <% include partials/nav %>

    <div class="container">
      <h4>
        <%= title %>
      </h4>
      <table>
        <thead>
          <tr>
            <th>Name</th>
          </tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < actors.length; i++){ %>
          <tr>
            <td>
              <a href="actor?name=<%= actors[i].name %>">
                <%= actors[i].name %></a>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </body>

</html>
