<!DOCTYPE html>
<html>
  <% include partials/head %>

  <body>
    <% include partials/nav %>

    <div class="container">
      <h4>
        <%= title %>
      </h4>
      <table>
        <thead>
          <tr>
            <th>Type</th>
            <th>Name</th>
            <th>Bound</th>
          </tr>
        </thead>
        <tr>
          <% for (let i = 0; i < actor.states.length; i++){ %>
        <tr>
          <td>
            <%= actor.states[i].type %>
          </td>
          <td>
            <a href="actor?name=<%= actor.name %>&state=<%= actor.states[i].name %> ">
              <%= actor.states[i].name  %>
          </td>
          <td>
            <%= actor.states[i].bound  %>
          </td>
        </tr>
        <% } %>
      </table>
    </div>
  </body>

</html>
